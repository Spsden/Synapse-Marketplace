# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Storage Configuration
SIGNED_URL_TTL_SECONDS=3600

# Storage Buckets
STORAGE_PLUGINS_BUCKET=plugins
STORAGE_ICONS_BUCKET=icons
STORAGE_TEMP_UPLOADS_BUCKET=temp_uploads

# Plugin Ingest (builds .synx artifacts from reviewed source)
# Repository holding one folder per plugin under GITHUB_PLUGIN_PATH.
GITHUB_PLUGIN_REPO=Spsden/Synapse-SDK
GITHUB_PLUGIN_PATH=plugins
# Optional. Raises the GitHub API rate limit and is required for private repos.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_MS=15000

# Vault Configuration (for OAuth token encryption)
# Generate with: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# OAuth Configuration
# Server URL for OAuth callbacks (required for HTTPS-only providers like Notion and Slack)
SERVER_URL=https://your-marketplace.com
OAUTH_CALLBACK_BASE_URL=http://localhost:3000

# Internal Service Tokens (generate with: openssl rand -base64 32)
# Used for service-to-service auth between Synapse Host App and Marketplace
OAUTH_INTERNAL_SERVICE_TOKEN=your-internal-service-token-here
OAUTH_DEVELOPER_API_TOKEN=your-developer-api-token-here
SYNAPSE_MARKETPLACE_TOKEN=your-marketplace-token-here
